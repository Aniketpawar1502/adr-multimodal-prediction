# ============================================================
# .gitignore — ADR Multi-Modal Prediction
# ============================================================

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/

# ── Virtual Environments ──────────────────────────────────
venv/
env/
ENV/
.venv/
.env/
conda_env/

# ── Data Files (too large for GitHub) ─────────────────────
data/raw/
data/processed/
*.csv
*.tsv
*.txt
*.ascii
*.zip
*.tar.gz
*.gz

# ── Model Checkpoints ─────────────────────────────────────
results/*.pt
results/*.pth
results/*.pkl
results/*.h5
*.ckpt
checkpoints/

# ── Jupyter Notebooks (output only) ───────────────────────
.ipynb_checkpoints/

# ── IDE & OS Specific ─────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────
*.log
logs/

# ── Environment Variables ─────────────────────────────────
.env
.env.local
*.secret

# ── AWS / Cloud ───────────────────────────────────────────
.aws/
*.pem
*.key

# ── Experiment Tracking ───────────────────────────────────
wandb/
mlruns/
.mlflow/

# ── Documentation Build ───────────────────────────────────
docs/_build/
site/

# ── Test Cache ────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
